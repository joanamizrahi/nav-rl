# Base configuration for every campus policy arm. Sourced by scripts/submit_arm.sh, then the
# arm file on top. Reviewed in git instead of retyped into a terminal, because a forty-line
# shell block is not reviewable and this month several bugs entered through one (2026-09-22).
#
# Anything here can be overridden in an arm file; anything an arm file sets that is NOT here is
# refused by submit_arm.sh, so a typo like GOLDIST=10 cannot silently do nothing.

LIVE=1                      # live generation, not a cache
REWSRC=generated            # the reward reads the co-generated labels, not the fused map
LIVECKPT=/scratch/m000204-pm07b/joana/runs/train_semantic_v35b_p6_ppl5/checkpoint-epoch-3.safetensors
SEMPAL=6
CLIPS_DIR=/scratch/m000204-pm07b/joana/data/campus_clips
TRAV=config/traversability_v14_walkway.yaml
WANDB_PROJECT=nav-rl-campus

# --- world model
STATICSCENE=1               # every frame's Gaussians render from any pose
RENDWIN=21                  # fusion window: reach vs sharpness
COVWIN=21                   # the coverage the gate reads
NOGATE=1                    # whole-frame coverage cost replaces the per-pixel alpha gate
LIVEBATCH=4
ROTATE=3000                 # env steps before the resident scene swaps

# --- episodes
MAXSTEPS=90                 # floor; MAXSTEPSPERM below grows it with the band
MAXSTEPSBASE=40             # episode budget = 40 + 16 x (top of the goal band)
MAXSTEPSPERM=16             # 2026-09-23: at 90 steps a 10 m goal is unreachable, so
                            # the policy stopped trying and crawled at 0.09 throttle
GOALRADIUS=1.0
SPAWNHEADWALK=1             # face the walk's direction, not the recorded camera yaw
SPAWNSUPPORT=12             # redraw a spawn already in collision
SPAWNJYAW=20                # anti-memorisation jitter; 0 makes every episode from a frame identical
SPAWNJLAT=0.4
MIRROR=0.5                  # verified consistent by tests/test_mirror_consistency.py

# --- goals and the curriculum
GOALRANGE=2,4               # the band at curriculum level one
GOALDISTWIN=2               # draw the target uniformly inside the band
GOALDIST=10                 # the ceiling the band climbs to
GOALDIST_START=2            # WITHOUT THIS THE CURRICULUM NEVER RUNS (2026-09-22)
# curriculum gate; empty = the old fast gate (0.5 over >=50 episodes, +0.5 m per notch)
CURTHRESH=
CURMINEP=
CURNOTCH=
CURPERSCENE=
# PPO entropy bonus. Empty = the script default 0.01, under which the action std
# never annealed from 1.0 in any arm (2026-09-25). 0 lets it shrink.
ENT=
DISAGREE=                   # per-step cost when generated labels and the map disagree (empty = off)
DISAGREEFRAC=               # footprint fraction that counts as a disagreement (empty = COLLTERM)
RGBALIGN=                   # per-step cost when the generated RGB drifts from the Gaussian raster (empty = off)
RGBALIGNTAU=
GOALSUPPORT=0.6
GOALMINSCORE=0.5            # goals only on sidewalk/pavement/trail/road
GOALJLAT=0.5

# --- reward
REWSCALE=0.01
RW5=1
RW5SMOOTH=1
SEMW=5
SPEEDCOST=1                 # terrain cost scaled by throttle
CRASHPEN=1000
COLLTERM=0.5
TIMEOUTDIST=1
PROX=5
PROXM=2
PROXGND=5
PROXGNDM=2
COH=10
COHTAU=0.4
COHTERM=0.1
MAPINFL=0.1
MAPINFLCLS=10,11,13

# --- collision box
LOOKAUTO=1
NEXTHEAD=1
CRASHMOVE=1

# --- run length
STEPS=300000
CKPTSTEPS=10000
IMGEVERY=20

# --- what an ARM may vary. Listed here with their off-values so submit_arm.sh can refuse a knob
# that does not exist (a typo like BOXMEN=5 would otherwise be silently ignored).
ENCODER=dinov2              # dinov2 | nature
IMGFIX=1                    # 1 for dinov2 (single /255). MUST be 0 for the nature CNN.
BOXMEM=                     # empty = no box memory; 5 = average the last 5 frames
BOXMEMAGG=mean
COLLAHEAD=0.7               # near box distance, only meaningful with BOXMEM
CHUNK=1                     # 1 = per action; 5 = Jing's trajectory arm
FRAMESTACK=1                # 1 = current view only; 3 = Jing's multiple-images arm
GOALTURN=                   # empty = no corner rule; 45 = corner goals beyond a 45 deg bend
GOALTURNMIX=                # share of episodes that try for a corner goal
GOALTURNBEYOND=2.0          # metres of walk before and after the bend
GOALTURNFROM=               # ramp the mix from 0 at this band distance (needs GOALDIST_START)
FRAMESTRIDE=1               # steps between stacked views; 3 spans 1.5 m instead of 0.5 m
